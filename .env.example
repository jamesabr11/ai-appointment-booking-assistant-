# ------------------------------------------------------------------
# Voice assistant (voice-assistant/main.py)
# Copy to voice-assistant/.env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Required: OpenAI API key with Realtime API access
OPENAI_API_KEY=sk-your-openai-api-key

# Required for automatic hang-up after a booking is saved
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Optional (defaults shown)
PORT=5050
TEMPERATURE=0.8
OPENAI_VOICE=alloy
HANGUP_DELAY_SECONDS=4

# ------------------------------------------------------------------
# Website / admin dashboard (web/)
# Optional. Put this in web/.env.local to override the default path,
# which is ../voice-assistant/call_logs/appointments.db
# ------------------------------------------------------------------
# APPOINTMENTS_DB_PATH=/absolute/path/to/appointments.db
